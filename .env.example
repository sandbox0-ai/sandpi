# Sandpi server
# Local development in this workspace must listen on 172.16.100.2 so devices on
# the HarmonyOS fusion network can reach it. Container deployments override
# SANDPI_HOST to 0.0.0.0 in compose.yaml.
SANDPI_HOST=172.16.100.2
SANDPI_PORT=3000
SANDPI_PUBLIC_URL=http://172.16.100.2:3000
SANDPI_LOG_LEVEL=info

# PostgreSQL
# This matches the PostgreSQL service in compose.yaml when accessed from the
# host. Sandpi runs migrations and seeds deployment defaults during startup.
DATABASE_URL=postgresql://sandpi:sandpi@127.0.0.1:55432/sandpi

# Identity
# "admin" is the self-hosted default: no login screen and one built-in owner.
# Change this to "oidc" and configure the commented OIDC values for multi-user
# deployments. Do not expose these settings in Sandpi Preferences.
SANDPI_AUTH_MODE=admin

# The cookie secret is required for OIDC. The data-encryption key is required
# for OIDC, before connecting an Environment to an official coding-agent
# account, and before creating Environment Webhooks. Generate independent
# values; do not reuse the Sandbox0 API key or the OIDC client secret.
# SANDPI_COOKIE_SECRET=replace-with-at-least-32-random-characters
# SANDPI_SECRET_KEY=generate-at-least-32-random-characters
# SANDPI_OIDC_ISSUER=https://identity.example.com/
# SANDPI_OIDC_CLIENT_ID=sandpi
# SANDPI_OIDC_CLIENT_SECRET=replace-with-oidc-client-secret
# SANDPI_OIDC_TOKEN_ENDPOINT_AUTH_METHOD=client_secret_post
# SANDPI_OIDC_SCOPES=openid profile email

# Sandbox0 deployment selected by the Sandpi operator.
# These credentials are deployment-wide server secrets, never per-user or
# per-Environment settings. The API key needs the permissions required to
# create Sandboxes, Volumes and Supervisor Sessions and read runtime metrics.
# Stripe billing also requires usage:read so Sandpi can consume immutable usage
# windows scoped by its deployment key through the official Sandbox0 SDK.
SANDBOX0_API_HOST=https://your-region.sandbox0.example
SANDBOX0_API_KEY=replace-with-sandpi-deployment-api-key

# Optional Sandpi subscription and quota enforcement. It is disabled by
# default, leaving self-hosted Environment count, memory and runtime unlimited.
# Use recurring annual Stripe Prices. A restricted runtime key is preferred;
# never expose it or the webhook secret through NEXT_PUBLIC_* variables.
# SANDPI_BILLING_MODE=stripe
# SANDPI_STRIPE_SECRET_KEY=rk_test_replace-me
# SANDPI_STRIPE_WEBHOOK_SECRET=whsec_replace-me
# SANDPI_STRIPE_PLUS_PRICE_ID=price_replace-with-plus
# SANDPI_STRIPE_PRO_PRICE_ID=price_replace-with-pro
# SANDPI_STRIPE_ULTRA_PRICE_ID=price_replace-with-ultra
# SANDPI_USAGE_POLL_INTERVAL_MS=15000

# In development, Next.js proxies the same-origin /api/v1 and /health paths to
# Fastify on port 3001. This keeps OIDC callbacks and cookies on the Web origin.

# Optional override for the exported Web assets served by Fastify.
# SANDPI_WEB_DIR=/absolute/path/to/sandpi/out

# Optional Google Analytics 4 measurement ID. Set this only for a deployment
# you operate; it is compiled into public browser assets during the Web build.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional Microsoft Clarity project ID. Set this only for a deployment you
# operate; it is compiled into public browser assets during the Web build.
# NEXT_PUBLIC_CLARITY_PROJECT_ID=xxxxxxxxxx
