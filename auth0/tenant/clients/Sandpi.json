{
  "name": "Sandpi",
  "description": "Sandpi OIDC web application",
  "app_type": "regular_web",
  "callbacks": [
    "##SANDPI_PUBLIC_URL##/api/v1/auth/callback"
  ],
  "grant_types": [
    "authorization_code"
  ],
  "is_first_party": true,
  "oidc_conformant": true,
  "token_endpoint_auth_method": "client_secret_post",
  "jwt_configuration": {
    "alg": "RS256"
  }
}
